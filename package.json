{
  "name": "flusiva",
  "version": "0.4.0",
  "description": "Video MP4 e audio MP3 dalle tue piattaforme preferite, sul tuo computer.",
  "author": "CosmoNet",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/prepare-tools.mjs && node node_modules/electron/install.js",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "5.3.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "info.cosmonet.flusiva",
    "productName": "Flusiva",
    "copyright": "Copyright © 2026 CosmoNet",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "public/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "tools"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-Flusiva.txt"
      }
    ],
    "artifactName": "Flusiva-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "CosmoNet",
      "synopsis": "Video MP4 e audio MP3 da cinque piattaforme"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": true
    },
    "publish": {
      "provider": "github",
      "owner": "CosmoNetinfo",
      "repo": "flusiva",
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=6.8.11"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
